{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1200px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "primary", "name": "Primary (Navy)", "color": "#0E4A6E" },
				{ "slug": "secondary", "name": "Secondary (Teal)", "color": "#0F8B8D" },
				{ "slug": "accent", "name": "Accent (Saffron)", "color": "#F29E1F" },
				{ "slug": "dark", "name": "Dark", "color": "#0B1F2E" },
				{ "slug": "ink", "name": "Ink (body text)", "color": "#1E2B36" },
				{ "slug": "muted", "name": "Muted", "color": "#5B6B78" },
				{ "slug": "line", "name": "Line (borders)", "color": "#DCE5EA" },
				{ "slug": "light", "name": "Light", "color": "#F3F7F9" },
				{ "slug": "white", "name": "White", "color": "#FFFFFF" }
			]
		},
		"typography": {
			"fluid": true,
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Inter",
					"fontFamily": "Inter, 'Noto Sans Devanagari', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontWeight": "300 800",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/inter-var.woff2" ]
						},
						{
							"fontFamily": "Noto Sans Devanagari",
							"fontWeight": "300 800",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"unicodeRange": "U+0900-097F, U+1CD0-1CF9, U+200C-200D, U+20A8, U+20B9, U+20F0, U+25CC, U+A830-A839, U+A8E0-A8FF",
							"src": [ "file:./assets/fonts/noto-sans-devanagari.woff2" ]
						}
					]
				},
				{
					"slug": "heading",
					"name": "Lora",
					"fontFamily": "Lora, 'Noto Serif Devanagari', Georgia, 'Times New Roman', serif",
					"fontFace": [
						{
							"fontFamily": "Lora",
							"fontWeight": "400 700",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/lora-var.woff2" ]
						},
						{
							"fontFamily": "Noto Serif Devanagari",
							"fontWeight": "400 700",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"unicodeRange": "U+0900-097F, U+1CD0-1CF9, U+200C-200D, U+20A8, U+20B9, U+20F0, U+25CC, U+A830-A839, U+A8E0-A8FF",
							"src": [ "file:./assets/fonts/noto-serif-devanagari.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "1.0625rem", "fluid": false },
				{ "slug": "large", "name": "Large", "size": "1.25rem", "fluid": { "min": "1.125rem", "max": "1.25rem" } },
				{ "slug": "x-large", "name": "Extra Large", "size": "1.75rem", "fluid": { "min": "1.4rem", "max": "1.75rem" } },
				{ "slug": "xx-large", "name": "Huge", "size": "2.75rem", "fluid": { "min": "2rem", "max": "2.75rem" } }
			]
		},
		"spacing": {
			"units": [ "px", "em", "rem", "%", "vh", "vw" ],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.5rem" },
				{ "slug": "30", "name": "S", "size": "1rem" },
				{ "slug": "40", "name": "M", "size": "1.5rem" },
				{ "slug": "50", "name": "L", "size": "clamp(2rem, 4vw, 3rem)" },
				{ "slug": "60", "name": "XL", "size": "clamp(3rem, 6vw, 5rem)" },
				{ "slug": "70", "name": "XXL", "size": "clamp(4rem, 8vw, 7rem)" }
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--ink)"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"left": "clamp(1rem, 4vw, 2rem)",
				"right": "clamp(1rem, 4vw, 2rem)"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.7"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--secondary)" },
				":hover": { "color": { "text": "var(--wp--preset--color--primary)" } }
			},
			"heading": {
				"color": { "text": "var(--wp--preset--color--primary)" },
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "700",
					"lineHeight": "1.25"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--dark)"
				},
				"border": { "radius": "999px" },
				"typography": { "fontWeight": "600", "fontSize": "0.9375rem" },
				"spacing": { "padding": { "top": "0.8rem", "bottom": "0.8rem", "left": "1.6rem", "right": "1.6rem" } },
				":hover": {
					"color": { "background": "#E08A0B", "text": "var(--wp--preset--color--dark)" }
				}
			}
		},
		"blocks": {
			"core/button": {
				"variations": {
					"outline": {
						"border": { "width": "2px", "color": "currentColor", "style": "solid" },
						"color": { "background": "transparent", "text": "currentColor" }
					}
				}
			},
			"core/separator": {
				"color": { "text": "var(--wp--preset--color--line)" }
			},
			"core/navigation": {
				"elements": {
					"link": { "color": { "text": "var(--wp--preset--color--ink)" } }
				}
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-no-title", "title": "Page without title banner", "postTypes": [ "page" ] }
	]
}
